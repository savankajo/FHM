// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  LEADER
  MEMBER
}

enum VoteStatus {
  YES
  NO
  MAYBE
}

enum EventVisibility {
  PUBLIC
  TEAM
}

enum RsvpStatus {
  REGISTERED
  WAITLISTED
  CANCELLED
}

enum NotificationType {
  REMINDER
  INVITATION
  MESSAGE
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum ChatContentType {
  TEXT
  VOICE
  POLL
}

enum ModerationStatus {
  PENDING
  PUBLISHED
  REMOVED
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  DISMISSED
  ACTIONED
}

enum ReportSource {
  USER_REPORT
  USER_BLOCK
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum ModerationOutcome {
  ALLOWED
  REJECTED
  MANUAL_REVIEW
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  name        String
  phone       String?
  role        Role     @default(MEMBER)
  permissions Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  teams                   Team[]               @relation("TeamMembers")
  ledTeams                Team[]               @relation("TeamLeaders")
  volunteeringFor         Service[]
  eventVotes              EventVote[]
  rsvps                   Rsvp[]
  eventInvitations        Invitation[]         @relation("InvitationUser")
  notifications           Notification[]
  notificationPreferences Json?
  accountStatus           AccountStatus        @default(ACTIVE)
  suspendedUntil          DateTime?
  termsAcceptedVersion    String?
  termsAcceptedAt         DateTime?
  chatMessages            ChatMessage[]
  createdEvents           Event[]              @relation("EventCreator")
  reports                 ChatReport[]         @relation("Reporter")
  blocksMade              UserBlock[]          @relation("Blocker")
  blocksReceived          UserBlock[]          @relation("Blocked")
  termsAcceptances        TermsAcceptance[]
  passwordResetTokens     PasswordResetToken[]
  bibleHighlights         BibleHighlight[]
  bibleNotes              BibleNote[]
}

model BibleHighlight {
  id               String   @id @default(uuid())
  version          String
  bookId           String
  chapterId        String
  chapterReference String
  verse            Int
  color            String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, version, chapterId, verse])
  @@index([userId, updatedAt])
}

model BibleNote {
  id               String   @id @default(uuid())
  version          String
  bookId           String
  chapterId        String
  chapterReference String
  verseKey         String
  verses           Int[]
  note             String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, version, chapterId, verseKey])
  @@index([userId, updatedAt])
}

model TermsAcceptance {
  id         String   @id @default(uuid())
  version    String
  acceptedAt DateTime @default(now())
  method     String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, version])
  @@index([acceptedAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Team {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  members     User[]        @relation("TeamMembers")
  leaders     User[]        @relation("TeamLeaders")
  services    Service[]
  events      Event[]       @relation("TeamEvents")
  messages    ChatMessage[]
  invitations Invitation[]
}

model Service {
  id            String   @id @default(uuid())
  title         String
  description   String?
  date          DateTime
  maxVolunteers Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  teamId     String
  team       Team   @relation(fields: [teamId], references: [id])
  volunteers User[]
}

enum SermonType {
  VIDEO
  PDF
}

enum VideoProvider {
  YOUTUBE
  VIMEO
}

model Sermon {
  id              String         @id @default(uuid())
  title           String
  speaker         String
  date            DateTime
  type            SermonType     @default(VIDEO)
  videoUrl        String?
  videoProvider   VideoProvider?
  videoId         String?
  fileUrl         String?
  isLive          Boolean        @default(false)
  notes           String?
  thumbnailUrl    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  audienceTeamIds Json?
}

model PodcastEpisode {
  id              String         @id @default(uuid())
  title           String
  description     String?
  publishedAt     DateTime
  audioUrl        String
  videoProvider   VideoProvider?
  videoId         String?
  thumbnailUrl    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  audienceTeamIds Json?
}

model Article {
  id              String   @id @default(uuid())
  title           String
  author          String
  summary         String?
  body            String?
  publishedAt     DateTime
  imageUrl        String?
  linkUrl         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  audienceTeamIds Json?
}

model Event {
  id             String          @id @default(uuid())
  title          String
  description    String?
  teamScope      String? // "ALL" or specific Team ID (handled in app logic if multiple needed, strictly simplfied here to 1 team or null for all)
  votingDeadline DateTime?
  locations      Json // Array of {name, address, mapUrl, startTime, endTime}
  startTime      DateTime?
  endTime        DateTime?
  location       String?
  visibility     EventVisibility @default(PUBLIC)
  teamId         String?
  isRecurring    Boolean         @default(false)
  recurrenceRule String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Relations
  createdByUserId String
  createdBy       User         @relation("EventCreator", fields: [createdByUserId], references: [id])
  teams           Team[]       @relation("TeamEvents") // If scoped to specific teams
  votes           EventVote[]
  rsvps           Rsvp[]
  invitations     Invitation[]

  @@index([visibility, startTime])
  @@index([teamId])
}

model Rsvp {
  id        String     @id @default(uuid())
  status    RsvpStatus @default(REGISTERED)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  eventId   String
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, status])
}

model Invitation {
  id          String    @id @default(uuid())
  sentAt      DateTime  @default(now())
  respondedAt DateTime?
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  teamId      String?
  team        Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation("InvitationUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([teamId])
  @@index([userId])
}

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String?

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model EventVote {
  id                    String     @id @default(uuid())
  status                VoteStatus
  selectedLocationIndex Int?
  createdAt             DateTime   @default(now())

  // Relations
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model ChatMessage {
  id               String           @id @default(uuid())
  text             String
  contentType      ChatContentType  @default(TEXT)
  moderationStatus ModerationStatus @default(PUBLISHED)
  moderationReason String?
  moderatedAt      DateTime?
  removedAt        DateTime?
  expiresAt        DateTime
  createdAt        DateTime         @default(now())

  // Relations
  teamId  String
  team    Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId  String
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports ChatReport[]

  @@index([teamId, moderationStatus, createdAt])
}

model ChatReport {
  id                   String                     @id @default(uuid())
  reason               String
  details              String?
  source               ReportSource               @default(USER_REPORT)
  status               ReportStatus               @default(OPEN)
  contentType          ChatContentType
  createdAt            DateTime                   @default(now())
  deadlineAt           DateTime
  reviewStartedAt      DateTime?
  resolvedAt           DateTime?
  moderatorId          String?
  moderatorAction      String?
  resolutionNote       String?
  reportedUserId       String
  teamId               String
  notificationStatus   NotificationDeliveryStatus @default(PENDING)
  notificationAttempts Int                        @default(0)
  notificationLastAt   DateTime?
  notificationError    String?
  notifiedAt           DateTime?
  escalatedAt          DateTime?
  reporterId           String
  reporter             User                       @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  messageId            String
  message              ChatMessage                @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([reporterId, messageId, source])
  @@index([status, deadlineAt])
  @@index([reportedUserId, createdAt])
  @@index([notificationStatus])
}

model UserBlock {
  id              String   @id @default(uuid())
  reason          String
  sourceMessageId String?
  createdAt       DateTime @default(now())
  blockerId       String
  blocker         User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId       String
  blocked         User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId, createdAt])
}

model ModerationAudit {
  id            String   @id @default(uuid())
  reportId      String?
  messageId     String?
  moderatorId   String
  subjectUserId String?
  action        String
  note          String
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([reportId, createdAt])
  @@index([subjectUserId, createdAt])
  @@index([moderatorId, createdAt])
}

model ContentModerationEvent {
  id          String            @id @default(uuid())
  userId      String?
  messageId   String?
  surface     String
  outcome     ModerationOutcome
  categories  Json?
  contentHash String
  createdAt   DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([outcome, createdAt])
}

model LiveLink {
  id        String   @id @default(uuid())
  url       String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
