# Database connection string (Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Secret for JWT signing (generate a random string)
JWT_SECRET="super-secret-key-change-this-in-production"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email sending for password reset links
RESEND_API_KEY="re_..."
PASSWORD_RESET_FROM="FHM Church <Media@fathersheartministry.ca>"
MODERATION_ALERT_FROM="FHM Church <Media@fathersheartministry.ca>"
MODERATION_ALERT_TO="Media@fathersheartministry.ca"
# Server-only API.Bible key for NIV, AMP, and MSG (never prefix with NEXT_PUBLIC_)
API_BIBLE_KEY=""

# Apple Push Notification service (server-only; never expose the .p8 key)
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APNS_BUNDLE_ID="com.savankajo.fhm"
# true for TestFlight/App Store builds; false only while testing a debug build
APNS_PRODUCTION="true"
